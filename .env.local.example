# Supabase - 프로젝트 설정 > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 카카오 (없으면 지도/주소검색이 목업 모드로 동작한다)
# JavaScript 키: 카카오 개발자 콘솔 > 내 애플리케이션 > 앱 키
#   플랫폼 > Web 에 http://localhost:3000 도메인 등록 필수
NEXT_PUBLIC_KAKAO_JS_KEY=
# REST API 키: 주소 -> 좌표 변환용. 서버에서만 사용된다.
KAKAO_REST_API_KEY=
