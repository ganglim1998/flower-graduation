# Supabase - 프로젝트 설정 > API 에서 복사
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# 네이버 지도 (없으면 지도가 간이 뷰로 동작한다)
# NCP 콘솔 > Maps > Application 에서 발급한 Client ID
#   Web 서비스 URL 에 http://localhost:3000 등록 필수
NEXT_PUBLIC_NAVER_MAP_CLIENT_ID=

# 카카오 REST API 키: 주소 <-> 좌표 변환용. 서버에서만 사용된다.
KAKAO_REST_API_KEY=
